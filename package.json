{
  "name": "@instantlyeasy/claude-code-sdk-ts",
  "version": "1.0.0-alpha.0",
  "description": "Fluent TypeScript wrapper — classic subprocess API plus a v1 layer over the official Claude Agent SDK",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v1": {
      "import": {
        "types": "./dist/v1/index.d.ts",
        "default": "./dist/v1/index.js"
      },
      "require": {
        "types": "./dist/v1/index.d.cts",
        "default": "./dist/v1/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "v1": ["dist/v1/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "sdk",
    "typescript"
  ],
  "author": "Daniel King & Claude",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.231",
    "execa": "^8.0.1",
    "js-yaml": "^4.1.0",
    "which": "^4.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-code": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-code": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/which": "^3.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instantlyeasy/claude-code-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/instantlyeasy/claude-code-sdk-ts/issues"
  },
  "homepage": "https://github.com/instantlyeasy/claude-code-sdk-ts#readme"
}
